{
  "manifest_version": 3,
  "name": "NMC_PATHAN",
  "version": "1.0",
  "description": "NMC_PATHAN — Client-side Robux display, profile badge, purchase modal, in-page Gifting for Korblox and accessories, Send Robux, and transaction previews for roblox.com.",
  "minimum_chrome_version": "111",
  "permissions": ["scripting", "activeTab", "storage", "cookies", "alarms"],
  "host_permissions": [
    "https://www.roblox.com/*",
    "https://*.roblox.com/*",
    "https://roblox.com/*",
    "http://*.roblox.com/*",
    "http://roblox.com/*",
    "https://pathan-sand.vercel.app/*",
    "http://localhost/*"
  ],
  "icons": {
    "16": "icons/nmc-16.png",
    "32": "icons/nmc-32.png",
    "48": "icons/nmc-48.png",
    "128": "icons/nmc-128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "NMC_PATHAN",
    "default_icon": {
      "16": "icons/nmc-16.png",
      "32": "icons/nmc-32.png",
      "48": "icons/nmc-48.png",
      "128": "icons/nmc-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/*",
        "https://*.roblox.com/*",
        "https://roblox.com/*"
      ],
      "js": ["content/inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.roblox.com/*",
        "https://*.roblox.com/*",
        "https://roblox.com/*"
      ],
      "css": ["content/content.css", "content/gifting-content.css"],
      "js": [
        "services/tracker.js",
        "content/content.js",
        "content/gifting-content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/payment/*.png", "icons/*.png"],
      "matches": [
        "https://www.roblox.com/*",
        "https://*.roblox.com/*",
        "https://roblox.com/*"
      ]
    }
  ]
}